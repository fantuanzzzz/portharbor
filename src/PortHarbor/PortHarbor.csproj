<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>0.1.0</Version>
    <AssemblyName>PortHarbor</AssemblyName>
    <Product>PortHarbor</Product>
    <Description>Lightweight Windows connection manager preview</Description>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../PortHarbor.Infrastructure/PortHarbor.Infrastructure.csproj" />
    <ProjectReference Include="../PortHarbor.Application/PortHarbor.Application.csproj" />
    <ProjectReference Include="../PortHarbor.Domain/PortHarbor.Domain.csproj" />
    <ProjectReference Include="../PortHarbor.Platform.Windows/PortHarbor.Platform.Windows.csproj" />
  </ItemGroup>
</Project>
